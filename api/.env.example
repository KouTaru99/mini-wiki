# ─── Biến môi trường mẫu — Mini-Wiki API ─────────────────────────────────────
# Sao chép file này thành .env và điền giá trị thật:
#   cp .env.example .env
# File .env KHÔNG được commit vào git (đã có trong .gitignore).

# Chuỗi kết nối PostgreSQL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=<schema>
DATABASE_URL="postgresql://dev:dev@localhost:5432/miniwiki?schema=public"

# Origin được phép gửi request đến API (CORS)
# Trỏ đến địa chỉ của front-end React + Vite
CORS_ORIGIN="http://localhost:5173"

# Port Express server lắng nghe
PORT=3000
