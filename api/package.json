{
  "name": "miniwiki-api",
  "version": "0.1.0",
  "description": "Mini-Wiki backend — Node.js 22 + Express 5 + Prisma 5 + PostgreSQL 16",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "prisma db seed",
    "generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5",
    "cors": "^2",
    "dotenv": "^16",
    "express": "^5",
    "isomorphic-dompurify": "^2",
    "marked": "^14",
    "morgan": "^1",
    "slugify": "^1"
  },
  "devDependencies": {
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/morgan": "^1",
    "@types/node": "^22.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "prisma": "^5",
    "supertest": "^7.2.2",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
